#!/bin/sh
# apv2.2 §5 — blokkér commit hvis bolletest eller versjonssjekk feiler.
# Installer: cp hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
cd "$(git rev-parse --show-toplevel)" || exit 1
node bolletest.js || {
  echo "apv2.2: bolletest feilet - commit blokkert."
  exit 1
}
